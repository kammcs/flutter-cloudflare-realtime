<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Routing call audio (docs/design.md §4.6). BLUETOOTH_CONNECT is the
         app's to declare and request: without it, Bluetooth routes are
         missing on Android 12+. -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

    <!-- Screen share (docs/design.md §10): the foreground service of type
         mediaProjection that Android 10+ requires while capturing the
         screen, and its notification (a runtime permission on Android 13+;
         without it the share still works, the notification just isn't in
         the drawer). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application>
        <service
            android:name="dev.kammcs.cloudflare_realtime.ScreenCaptureService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection"
            android:stopWithTask="true" />
    </application>
</manifest>
