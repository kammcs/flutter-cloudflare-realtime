# Copy to .env (git-ignored) and fill in. Real environment variables win over this file.
# DEV ONLY. Never commit .env.

# Required: must be exactly 1, or the server refuses to start.
REALTIME_DEV_SERVER=1

# Required: Cloudflare dashboard > Realtime > SFU.
CF_REALTIME_APP_ID=your-sfu-app-id
CF_REALTIME_APP_SECRET=your-sfu-app-secret

# Optional: Cloudflare dashboard > Realtime > TURN. Without them, clients get STUN only.
# CF_TURN_KEY_ID=your-turn-key-id
# CF_TURN_API_TOKEN=your-turn-api-token

# Optional: a fixed dev token (at least 16 characters). Without it, a random one is
# generated at each start and printed.
# DEV_TOKEN=

# Optional: allowed browser origins for Flutter Web (comma-separated, or *). Default: *.
# DEV_CORS_ORIGINS=*
