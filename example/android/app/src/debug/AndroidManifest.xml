<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- The INTERNET permission is required for development. Specifically,
         the Flutter tool needs it to communicate with the running application
         to allow setting breakpoints, to provide hot reload, etc.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- Debug builds only, for integration_test/system_call_test.dart: a
         companion InCallService (TestCallCompanion) that ends a ringing call
         from Telecom's side. Telecom binds it only while the app op
         MANAGE_ONGOING_CALLS is allowed (system_call_test_driver.sh). -->
    <uses-permission
        android:name="android.permission.MANAGE_ONGOING_CALLS"
        tools:ignore="ProtectedPermissions" />
    <!-- Debug builds only: allow cleartext HTTP/WS to the local dev server
         (tools/dev-server) on a LAN IP. See res/xml/network_security_config.xml. -->
    <application android:networkSecurityConfig="@xml/network_security_config">
        <service
            android:name=".TestCallCompanion"
            android:exported="true"
            android:permission="android.permission.BIND_INCALL_SERVICE">
            <meta-data
                android:name="android.telecom.INCLUDE_SELF_MANAGED_CALLS"
                android:value="true" />
            <intent-filter>
                <action android:name="android.telecom.InCallService" />
            </intent-filter>
        </service>
    </application>
</manifest>
